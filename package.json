{
	"name": "@mhkeller/layercake-annotations",
	"version": "1.0.0",
	"description": "Interactive text annotations with swoopy arrows for Layer Cake charts",
	"homepage": "https://mhkeller.github.io/layercake-annotations/",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mhkeller/layercake-annotations.git"
	},
	"license": "MIT",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && pnpm package",
		"preview": "vite preview",
		"package": "svelte-kit sync && svelte-package -o dist && publint",
		"prepublishOnly": "pnpm package",
		"check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"test": "pnpm test:unit && pnpm test:e2e",
		"test:unit": "node --test tests/unit/*.test.js",
		"test:e2e": "playwright test",
		"test:ui": "playwright test --ui",
		"test:update": "playwright test --update-snapshots"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./types": {
			"types": "./dist/types.d.ts"
		}
	},
	"sideEffects": false,
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"peerDependencies": {
		"layercake": "^11.0.0",
		"svelte": ">=5.40"
	},
	"devDependencies": {
		"@playwright/test": "^1.57.0",
		"@rollup/plugin-dsv": "^3.0.4",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@types/node": "^22.20.2",
		"d3-scale": "^4.0.2",
		"layercake": "^11.0.0",
		"prettier": "^3.1.1",
		"prettier-plugin-svelte": "^3.1.2",
		"publint": "^0.3.24",
		"svelte": "^5.57.0",
		"svelte-check": "^4.0.0",
		"typescript": "^5.0.0",
		"vite": "^8.3.0"
	},
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module"
}
